{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "share:default",
    "sharekit:default",
    "fs:default",
    "fs:allow-write-file",
    "fs:allow-read-file",
    "fs:allow-appcache-write-recursive",
    "fs:allow-appcache-read-recursive",
    "fs:scope-appcache-recursive"
  ]
}
